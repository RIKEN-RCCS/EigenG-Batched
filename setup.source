SCRIPT_FILE=${BASH_SOURCE[0]}
PYTHON_EXE=python
version=$(python -V 2>&1 | grep -Po '(?<=Python )(.+)')
if [[ -z "$version" ]]
then
    PYTHON_EXE=python3
    version=$(python3 -V 2>&1 | grep -Po '(?<=Python )(.+)')
    if [[ -z "$version" ]]
    then
    echo "No Python is detected! Cannot source" 
    return
    fi
fi
SCRIPT=$($PYTHON_EXE -c "import os,sys; print(os.path.realpath(os.path.expanduser(sys.argv[1])))" ${SCRIPT_FILE})
export EIGEN=$(dirname -- ${SCRIPT})
export LD_LIBRARY_PATH=$EIGEN:$LD_LIBRARY_PATH
